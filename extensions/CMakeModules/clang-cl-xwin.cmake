# Cross-compile the Windows extensions and TeamSpeak plugin from Linux with clang-cl, lld-link and an xwin splat.
# Usage: cmake -G Ninja -DCMAKE_TOOLCHAIN_FILE=CMakeModules/clang-cl-xwin.cmake -DUSE_64BIT_BUILD=ON|OFF
# XWIN_ROOT (default /opt/xwin) is the output of `xwin splat`. The LLVM tools must be on PATH.
if(CMAKE_VERSION VERSION_LESS 3.19)
    message(FATAL_ERROR "clang-cl-xwin.cmake needs CMake 3.19 or later, found ${CMAKE_VERSION}")
endif()

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES USE_64BIT_BUILD XWIN_ROOT)

if(NOT XWIN_ROOT)
    set(XWIN_ROOT "$ENV{XWIN_ROOT}")
endif()
if(NOT XWIN_ROOT)
    set(XWIN_ROOT "/opt/xwin")
endif()
# The SDK paths go into flag strings that CMake splits on spaces.
if(XWIN_ROOT MATCHES " ")
    message(FATAL_ERROR "XWIN_ROOT must not contain spaces: '${XWIN_ROOT}'")
endif()
# The *_FLAGS_INIT values below seed the cache only once, so a build directory is bound to one SDK root and architecture.
set(_xwin_signature "${XWIN_ROOT}|${USE_64BIT_BUILD}")
if(DEFINED CACHE{ACRE_XWIN_SIGNATURE} AND NOT ACRE_XWIN_SIGNATURE STREQUAL _xwin_signature)
    message(FATAL_ERROR "This build directory was configured for '${ACRE_XWIN_SIGNATURE}', not '${_xwin_signature}'. Use a clean build directory.")
endif()
set(ACRE_XWIN_SIGNATURE "${_xwin_signature}" CACHE INTERNAL "")

if(USE_64BIT_BUILD)
    set(CMAKE_SYSTEM_PROCESSOR AMD64)
    set(_target x86_64-pc-windows-msvc)
    set(_libarch x86_64)
    set(_dxarch x64)
    set(_machine i386:x86-64)
    set(_ml_flag -m64)
else()
    set(CMAKE_SYSTEM_PROCESSOR X86)
    set(_target i686-pc-windows-msvc)
    set(_libarch x86)
    set(_dxarch x86)
    set(_machine i386)
    set(_ml_flag -m32)
    set(_arch_flag /arch:SSE2)
endif()

set(CMAKE_C_COMPILER clang-cl)
set(CMAKE_CXX_COMPILER clang-cl)
set(CMAKE_C_COMPILER_TARGET ${_target})
set(CMAKE_CXX_COMPILER_TARGET ${_target})
set(CMAKE_LINKER lld-link)
set(CMAKE_AR llvm-lib)
# The version resource holds a UTF-8 copyright sign. llvm-rc reads ASCII only unless told the code page.
set(_rc_wrapper "${CMAKE_BINARY_DIR}/llvm-rc-utf8")
if(NOT EXISTS "${_rc_wrapper}")
    file(WRITE "${_rc_wrapper}" "#!/bin/sh\nexec llvm-rc /C 65001 \"$@\"\n")
    file(CHMOD "${_rc_wrapper}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
set(CMAKE_RC_COMPILER "${_rc_wrapper}")
set(CMAKE_MT llvm-mt)
set(CMAKE_ASM_MASM_COMPILER llvm-ml)

set(_inc "/imsvc ${XWIN_ROOT}/crt/include /imsvc ${XWIN_ROOT}/sdk/include/ucrt /imsvc ${XWIN_ROOT}/sdk/include/um /imsvc ${XWIN_ROOT}/sdk/include/shared")
set(CMAKE_C_FLAGS_INIT "${_inc} ${_arch_flag} -Wno-invalid-token-paste")
set(CMAKE_CXX_FLAGS_INIT "${_inc} ${_arch_flag} /EHsc -Wno-invalid-token-paste")
set(CMAKE_ASM_MASM_FLAGS_INIT "${_ml_flag}")
set(CMAKE_RC_FLAGS_INIT "-I ${XWIN_ROOT}/sdk/include/um -I ${XWIN_ROOT}/sdk/include/shared -I ${XWIN_ROOT}/sdk/include/ucrt -I ${XWIN_ROOT}/crt/include")

set(_libs "/libpath:${XWIN_ROOT}/crt/lib/${_libarch} /libpath:${XWIN_ROOT}/sdk/lib/um/${_libarch} /libpath:${XWIN_ROOT}/sdk/lib/ucrt/${_libarch}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_libs}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_libs}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_libs}")

# Stand-in for the June 2010 DirectX SDK layout that FindDirectX expects. x3daudio.lib links X3DAudio1_7.dll like the SDK import library.
set(DirectX_D3DX11_INCLUDE_DIR "${XWIN_ROOT}/sdk/include/shared" CACHE PATH "")
set(DirectX_D3DX11_LIBRARY "${XWIN_ROOT}/sdk/lib/um/${_libarch}" CACHE PATH "")
if(NOT DEFINED ENV{DXSDK_DIR})
    set(_dx "${CMAKE_BINARY_DIR}/xwin-dx")
    file(MAKE_DIRECTORY "${_dx}/include" "${_dx}/lib/${_dxarch}")
    file(CREATE_LINK "${XWIN_ROOT}/sdk/include/shared/d3d9.h" "${_dx}/include/d3d9.h" SYMBOLIC)
    file(CREATE_LINK "${XWIN_ROOT}/sdk/lib/um/${_libarch}/d3d9.lib" "${_dx}/lib/${_dxarch}/d3d9.lib" SYMBOLIC)
    execute_process(
        COMMAND llvm-dlltool -m ${_machine} -d "${CMAKE_CURRENT_LIST_DIR}/x3daudio1_7.def" -l "${_dx}/lib/${_dxarch}/x3daudio.lib"
        RESULT_VARIABLE _dlltool_result)
    if(NOT _dlltool_result EQUAL 0)
        message(FATAL_ERROR "llvm-dlltool failed to create x3daudio.lib")
    endif()
    set(ENV{DXSDK_DIR} "${_dx}")
endif()
